# Contact form delivery. Leave empty to fall back to opening the visitor's
# email app (mailto:) with the enquiry pre-filled. No submissions are stored.
#
# Any JSON form endpoint works, e.g. Formspree (https://formspree.io/f/xxxx)
# or Web3Forms (https://api.web3forms.com/submit + access key).
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=

# "false" hides draft markers (media slot labels, "pending verification" tags,
# placeholder testimonials). Set only once the client has verified the content.
VITE_DRAFT=true
